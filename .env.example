# Trackash self-hosted — optional settings. The app needs no .env: the Pluggy
# credentials are entered in the setup screen and stored in the local database.
# Copy this file to .env only to change something below. Never commit .env.

# Where the SQLite database lives (default: data/trackash.db in the project folder,
# which git ignores). Keep it on your own disk, readable only by your user.
TRACKASH_DB_PATH=
